# Cloud Run supplies PORT and application-default credentials through its service account.
NODE_ENV=production
PORT=8080
FIREBASE_PROJECT_ID=your-firebase-project
PORTAL_ORIGIN=https://your-portal.web.app
# Store the private JWK in Secret Manager; do not commit it or put it in frontend VITE_* settings.
PORTAL_SIGNING_KEY_JSON={"kty":"OKP","crv":"Ed25519","x":"replace-public-key","d":"replace-private-key"}
