              "type": "string",
              "minLength": 1
            },
            "default": []
          },
          "settings": {
            "type": "object",
            "properties": {
              "folder": {
                "type": "string",
                "minLength": 1
              },
              "naming": {
                "type": "string",
                "default": "{device}-{date}-{time}"
              },
              "owner": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128,
                "default": "You"
              },
              "ttl": {
                "type": "integer",
                "minimum": 1,
                "maximum": 240,
                "default": 15
              },
              "overlay": {
                "type": "boolean",
                "default": true
              },
              "logging": {
                "type": "boolean",
                "default": true
              },
              "clipboard": {
                "type": "boolean",
                "default": false
              },
              "captureMode": {
                "type": "string",
                "enum": [
                  "clean",
                  "annotated"
                ],
                "default": "clean"
              },
              "maxRecordingMinutes": {
                "type": "integer",
                "minimum": 1,
                "maximum": 120,
                "default": 15
              },
              "previewIntervalMs": {
                "type": "integer",
                "minimum": 250,
                "maximum": 5000,
                "default": 750
              }
            },
            "required": [
              "folder"
            ],
            "additionalProperties": false
          },
          "tools": {
            "type": "object",
            "properties": {
              "adb": {
                "type": "string"
              },
              "emulator": {
                "type": "string"
              },
              "ffmpeg": {
                "type": "string"
              },
              "ffprobe": {
                "type": "string"
              },
              "idb": {
                "type": "string"
              },
              "iproxy": {
                "type": "string"
              },
              "python": {
                "type": "string"
              }
            },
            "additionalProperties": false,
            "default": {}
          },
          "savedViews": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 32
                },
                "filters": {
                  "type": "object",
                  "additionalProperties": {
                    "type": "string"
                  }
                }
              },
              "required": [
                "name",
                "filters"
              ],
              "additionalProperties": false
            },
            "default": []
          }
        },
        "required": [
          "schemaVersion",
          "settings"
        ],
        "additionalProperties": false
      },
      "revision": {
        "type": "string"
      }
    },
    "required": [
      "config",
      "revision"
    ],
    "additionalProperties": false,
    "$schema": "http://json-schema.org/draft-07/schema#"
  },
