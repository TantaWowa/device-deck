    ],
    "additionalProperties": false,
    "$schema": "http://json-schema.org/draft-07/schema#"
  },
  "sessions.takeover": {
    "type": "object",
    "properties": {
      "deviceId": {
        "type": "string"
      },
      "reason": {
        "type": "string",
        "minLength": 1
      },
      "owner": {
        "type": "string",
        "minLength": 1
      },
      "confirmed": {
        "type": "boolean",
        "const": true
      }
    },
    "required": [
      "deviceId",
      "reason",
      "owner",
      "confirmed"
    ],
    "additionalProperties": false,
    "$schema": "http://json-schema.org/draft-07/schema#"
  },
  "devices.bulk": {
    "type": "object",
    "properties": {
      "ids": {
        "type": "array",
        "items": {
          "type": "string"
        },
        "minItems": 1,
        "maxItems": 100
      },
      "action": {
        "type": "string",
        "enum": [
          "lock",
          "unlock",
          "restart"
        ]
      },
      "reason": {
        "type": "string",
        "minLength": 1
      }
    },
    "required": [
      "ids",
      "action",
      "reason"
    ],
    "additionalProperties": false,
    "$schema": "http://json-schema.org/draft-07/schema#"
  },
  "pairing.start": {
    "type": "object",
    "properties": {
      "sessionId": {
        "type": "string",
        "minLength": 1
      },
      "leaseToken": {
        "type": "string",
        "minLength": 1
      }
    },
    "required": [
      "sessionId",
      "leaseToken"
    ],
    "additionalProperties": false,
    "$schema": "http://json-schema.org/draft-07/schema#"
  },
  "pairing.finish": {
    "type": "object",
    "properties": {
      "sessionId": {
        "type": "string",
        "minLength": 1
      },
      "leaseToken": {
        "type": "string",
        "minLength": 1
      },
      "pin": {
        "type": "string",
        "pattern": "^\\d{4,6}$"
      }
    },
    "required": [
      "sessionId",
      "leaseToken",
      "pin"
    ],
    "additionalProperties": false,
    "$schema": "http://json-schema.org/draft-07/schema#"
  },
  "remote.input": {
    "type": "object",
    "properties": {
      "sessionId": {
        "type": "string",
        "minLength": 1
      },
      "leaseToken": {
        "type": "string",
        "minLength": 1
      },
      "key": {
        "type": "string",
        "maxLength": 64
      },
      "text": {
        "type": "string",
        "minLength": 1,
        "maxLength": 4096
      },
      "x": {
        "type": "number",
        "minimum": 0,
        "maximum": 10000
      },
      "y": {
        "type": "number",
        "minimum": 0,
        "maximum": 10000
      }
    },
    "required": [
      "sessionId",
      "leaseToken"
    ],
    "additionalProperties": false,
    "$schema": "http://json-schema.org/draft-07/schema#"
  },
  "captures.screenshot": {
    "type": "object",
    "properties": {
      "sessionId": {
        "type": "string",
        "minLength": 1
      },
      "leaseToken": {
        "type": "string",
