                      "required": [
                        "type",
                        "host",
                        "identifier"
                      ],
                      "additionalProperties": false
                    },
                    {
                      "type": "object",
                      "properties": {
                        "type": {
                          "type": "string",
                          "const": "apple-device"
                        },
                        "udid": {
                          "type": "string",
                          "minLength": 1
                        },
                        "webDriverAgent": {
                          "type": "object",
                          "properties": {
                            "port": {
                              "type": "integer",
                              "minimum": 1,
                              "maximum": 65535,
                              "default": 8100
                            }
                          },
                          "additionalProperties": false
                        }
                      },
                      "required": [
                        "type",
                        "udid"
                      ],
                      "additionalProperties": false
                    }
                  ]
                },
                "captureSourceId": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "default": null
                }
              },
              "required": [
                "id",
                "name",
                "platform",
                "kind",
                "connection"
              ],
              "additionalProperties": false
            },
            "default": []
          },
          "sources": {
            "type": "array",
