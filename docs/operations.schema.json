  "reports.get": {
    "type": "object",
    "properties": {
      "preset": {
        "type": "string",
        "enum": [
          "day",
          "week",
          "month",
          "custom"
        ],
        "description": "Default day. Calendar periods use the daemon Mac timezone; weeks start Monday."
      },
      "start": {
        "type": "string",
        "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
        "description": "Custom first calendar date, YYYY-MM-DD, inclusive."
      },
      "end": {
        "type": "string",
        "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
        "description": "Custom last calendar date, YYYY-MM-DD, inclusive."
      }
    },
    "additionalProperties": false,
    "$schema": "http://json-schema.org/draft-07/schema#"
  },
  "config.get": {
    "type": "object",
    "properties": {},
    "additionalProperties": false,
    "$schema": "http://json-schema.org/draft-07/schema#"
  },
  "config.save": {
    "type": "object",
    "properties": {
      "config": {
        "type": "object",
        "properties": {
          "schemaVersion": {
            "type": "number",
            "const": 1
          },
          "port": {
            "type": "integer",
            "minimum": 0,
            "maximum": 65535,
            "default": 47831
          },
          "devices": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128,
                  "pattern": "^[\\w.-]+$"
                },
                "name": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 64
                },
                "platform": {
                  "type": "string",
                  "enum": [
                    "Roku",
                    "Android",
                    "Apple",
                    "Other"
                  ]
                },
                "kind": {
                  "type": "string",
                  "enum": [
                    "physical",
                    "virtual"
                  ]
                },
                "model": {
                  "type": "string",
                  "maxLength": 256,
                  "default": ""
                },
                "visibility": {
                  "type": "string",
                  "enum": [
                    "local",
                    "shared"
                  ],
                  "default": "local"
                },
                "connection": {
                  "anyOf": [
                    {
                      "type": "object",
                      "properties": {
                        "type": {
                          "type": "string",
                          "const": "capture"
                        }
                      },
                      "required": [
                        "type"
                      ],
                      "additionalProperties": false
                    },
                    {
                      "type": "object",
                      "properties": {
                        "type": {
                          "type": "string",
                          "const": "roku"
                        },
                        "host": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 253,
                          "pattern": "^[\\w.:-]+$"
                        },
                        "serial": {
                          "type": "string",
                          "minLength": 1
                        }
                      },
                      "required": [
                        "type",
                        "host",
                        "serial"
                      ],
                      "additionalProperties": false
                    },
                    {
                      "type": "object",
                      "properties": {
                        "type": {
                          "type": "string",
                          "const": "adb"
                        },
                        "serial": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 256
                        },
                        "hardwareId": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 256
                        },
                        "port": {
                          "type": "integer",
                          "minimum": 1,
                          "maximum": 65535,
                          "default": 5037
                        }
                      },
                      "required": [
                        "type",
                        "serial"
                      ],
                      "additionalProperties": false
                    },
                    {
                      "type": "object",
                      "properties": {
                        "type": {
                          "type": "string",
                          "const": "simulator"
                        },
                        "udid": {
                          "type": "string",
                          "format": "uuid"
                        },
                        "os": {
                          "type": "string",
                          "enum": [
                            "ios",
                            "tvos"
                          ]
                        }
                      },
                      "required": [
                        "type",
                        "udid",
                        "os"
                      ],
                      "additionalProperties": false
                    },
                    {
                      "type": "object",
                      "properties": {
                        "type": {
                          "type": "string",
                          "const": "apple-tv"
                        },
                        "host": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 253,
                          "pattern": "^[\\w.:-]+$"
                        },
                        "identifier": {
                          "type": "string",
                          "minLength": 1
                        }
                      },
                      "required": [
                        "type",
                        "host",
                        "identifier"
                      ],
                      "additionalProperties": false
                    },
                    {
                      "type": "object",
                      "properties": {
                        "type": {
                          "type": "string",
                          "const": "apple-device"
                        },
                        "udid": {
                          "type": "string",
                          "minLength": 1
                        }
                      },
                      "required": [
                        "type",
                        "udid"
                      ],
                      "additionalProperties": false
                    }
                  ]
                },
                "captureSourceId": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "default": null
                }
              },
              "required": [
                "id",
                "name",
                "platform",
                "kind",
                "connection"
              ],
              "additionalProperties": false
            },
            "default": []
          },
          "sources": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 160
                },
                "name": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256
                },
                "kind": {
                  "type": "string",
                  "enum": [
                    "usb",
                    "native"
                  ]
                },
                "deviceId": {
                  "type": "string"
                },
                "uniqueId": {
                  "type": "string"
                }
              },
              "required": [
                "id",
                "name",
                "kind"
              ],
              "additionalProperties": false
            },
            "default": []
          },
          "settings": {
            "type": "object",
            "properties": {
              "folder": {
                "type": "string",
                "minLength": 1
              },
              "naming": {
                "type": "string",
                "default": "{device}-{date}-{time}"
              },
              "owner": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128,
                "default": "You"
              },
              "ttl": {
                "type": "integer",
                "minimum": 1,
                "maximum": 240,
                "default": 15
              },
              "overlay": {
                "type": "boolean",
                "default": true
              },
              "logging": {
                "type": "boolean",
                "default": true
              },
              "clipboard": {
                "type": "boolean",
                "default": false
              },
              "captureMode": {
                "type": "string",
                "enum": [
                  "clean",
                  "annotated"
                ],
                "default": "clean"
              },
              "maxRecordingMinutes": {
                "type": "integer",
                "minimum": 1,
                "maximum": 120,
                "default": 15
              },
              "previewIntervalMs": {
                "type": "integer",
                "minimum": 250,
                "maximum": 5000,
                "default": 750
              }
            },
            "required": [
              "folder"
            ],
            "additionalProperties": false
          },
          "tools": {
            "type": "object",
            "properties": {
              "adb": {
                "type": "string"
              },
              "ffmpeg": {
                "type": "string"
              },
              "ffprobe": {
                "type": "string"
              },
              "idb": {
                "type": "string"
              },
              "python": {
                "type": "string"
              }
            },
            "additionalProperties": false,
            "default": {}
          },
          "savedViews": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 32
                },
                "filters": {
                  "type": "object",
                  "additionalProperties": {
                    "type": "string"
                  }
                }
              },
              "required": [
                "name",
                "filters"
              ],
              "additionalProperties": false
            },
            "default": []
          }
        },
        "required": [
          "schemaVersion",
          "settings"
        ],
        "additionalProperties": false
      },
      "revision": {
        "type": "string"
      }
    },
    "required": [
      "config",
      "revision"
    ],
    "additionalProperties": false,
    "$schema": "http://json-schema.org/draft-07/schema#"
  },
  "sessions.reserve": {
    "type": "object",
    "properties": {
      "selector": {
        "type": "object",
        "properties": {
          "device": {
            "type": "string"
          },
          "platform": {
            "type": "string",
            "enum": [
              "Roku",
              "Android",
              "Apple",
              "Other"
            ]
          },
          "name": {
            "type": "string"
          },
          "state": {
            "type": "string",
            "enum": [
              "free",
              "reserved",
              "online",
              "offline",
              "locked"
            ]
          },
          "capabilities": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "preview",
                "key",
                "text",
                "screenshot",
                "record",
                "restart"
              ]
            }
          }
        },
        "additionalProperties": false
      },
      "owner": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128
      },
      "reason": {
        "type": "string",
        "minLength": 1,
        "maxLength": 512
      },
      "ttlMinutes": {
        "type": "integer",
        "minimum": 1,
        "maximum": 240
      }
    },
    "required": [
      "selector",
      "owner",
      "reason"
    ],
    "additionalProperties": false,
    "$schema": "http://json-schema.org/draft-07/schema#"
  },
  "sessions.renew": {
    "type": "object",
    "properties": {
      "sessionId": {
        "type": "string",
        "minLength": 1
      },
      "leaseToken": {
        "type": "string",
        "minLength": 1
      },
      "ttlMinutes": {
        "type": "integer",
        "minimum": 1,
        "maximum": 240
      }
    },
    "required": [
      "sessionId",
      "leaseToken"
    ],
    "additionalProperties": false,
    "$schema": "http://json-schema.org/draft-07/schema#"
  },
  "sessions.release": {
    "type": "object",
    "properties": {
