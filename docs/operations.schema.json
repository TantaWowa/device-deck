                        "type"
                      ],
                      "additionalProperties": false
                    },
                    {
                      "type": "object",
                      "properties": {
                        "type": {
                          "type": "string",
                          "const": "roku"
                        },
                        "host": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 253,
                          "pattern": "^[\\w.:-]+$"
                        },
                        "serial": {
                          "type": "string",
                          "minLength": 1
                        }
                      },
                      "required": [
                        "type",
                        "host",
                        "serial"
                      ],
                      "additionalProperties": false
                    },
                    {
                      "type": "object",
                      "properties": {
                        "type": {
                          "type": "string",
                          "const": "adb"
                        },
                        "serial": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 256
                        },
                        "hardwareId": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 256
                        },
                        "avdName": {
                          "type": "string",
                          "maxLength": 256,
                          "pattern": "^[A-Za-z0-9_][A-Za-z0-9_.-]*$"
                        },
                        "port": {
                          "type": "integer",
                          "minimum": 1,
                          "maximum": 65535,
                          "default": 5037
                        }
                      },
                      "required": [
                        "type",
                        "serial"
                      ],
                      "additionalProperties": false
                    },
                    {
                      "type": "object",
                      "properties": {
                        "type": {
                          "type": "string",
                          "const": "simulator"
                        },
                        "udid": {
                          "type": "string",
                          "format": "uuid"
                        },
                        "os": {
                          "type": "string",
                          "enum": [
                            "ios",
                            "tvos"
                          ]
                        }
                      },
                      "required": [
                        "type",
                        "udid",
                        "os"
                      ],
                      "additionalProperties": false
                    },
                    {
                      "type": "object",
                      "properties": {
                        "type": {
                          "type": "string",
                          "const": "apple-tv"
                        },
                        "host": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 253,
