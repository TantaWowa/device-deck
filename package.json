{
  "name": "device-deck",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite apps/website --host 127.0.0.1 --port 5173 --strictPort",
    "dev:app": "vite apps/web --host 127.0.0.1 --port 5174 --strictPort",
    "build": "vite build apps/website --outDir ../../dist --emptyOutDir && vite build apps/web --base=/demo/ --outDir ../../dist/demo --emptyOutDir",
    "check": "tsc --noEmit",
    "qa": "node scripts/qa.mjs",
    "test": "node --import tsx --test apps/daemon/src/*.test.ts apps/billing/src/*.test.ts apps/cli/src/*.test.ts packages/*/src/*.test.ts",
    "service": "node --import tsx apps/daemon/src/index.ts",
    "install:dev-cli": "node scripts/install-dev-cli.mjs",
    "service:local": "node --import tsx scripts/service-local.ts",
    "cli": "node --import tsx apps/cli/src/index.ts",
    "mcp": "node --import tsx packages/mcp/src/index.ts",
    "preview": "vite preview apps/website --outDir ../../dist --host 127.0.0.1 --port 5173 --strictPort",
    "tui": "node --import tsx apps/tui/src/index.ts",
    "build:local": "node scripts/build-local.mjs",
    "schema": "node --import tsx scripts/schema.ts",
    "package:local": "node scripts/package-local.mjs",
    "build:installer": "node scripts/build-installer.mjs",
    "billing:serve": "node --import tsx apps/billing/src/index.ts",
    "billing:recover-lock": "node --import tsx scripts/recover-billing-lock.ts"
  },
  "dependencies": {
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "lucide-react": "^0.468.0",
    "@modelcontextprotocol/sdk": "^1.17.5",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "typescript": "^5.9.2",
    "vite": "^7.1.5",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@types/node": "^24.3.1",
    "tsx": "^4.20.5",
    "@playwright/test": "^1.55.0",
    "esbuild": "^0.25.9",
    "zod-to-json-schema": "^3.25.2"
  }
}
