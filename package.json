{
  "name": "device-deck",
  "version": "0.5.0-beta.1",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "qa:connection-screen": "node scripts/qa-connection-screen.mjs",
    "qa:navigation": "node scripts/qa-navigation.mjs",
    "qa:live-video": "node scripts/qa-live-video.mjs",
    "qa:ios-production": "node scripts/qa-ios-native-production.mjs",
    "qa:device-types": "node scripts/qa-device-types.mjs",
    "qa:touch-feedback": "node scripts/qa-touch-feedback.mjs",
    "qa:ios-video": "node --import tsx scripts/qa-ios-native-video.mjs",
    "qa:captures": "node scripts/qa-captures.mjs",
    "qa:portal-captures": "node scripts/qa-portal-captures.mjs",
    "dev": "vite apps/website --host 127.0.0.1 --port 5173 --strictPort",
    "dev:app": "vite apps/web --host 127.0.0.1 --port 5174 --strictPort",
    "build": "vite build apps/website --outDir ../../dist --emptyOutDir && vite build apps/web --base=/demo/ --outDir ../../dist/demo --emptyOutDir && npm run build:portal",
    "check": "tsc --noEmit",
    "qa": "node scripts/qa.mjs",
    "qa:custom-devices": "node --import tsx scripts/qa-custom-devices.ts",
    "screenshots:website": "node scripts/marketing-screenshots.mjs",
    "test": "node --import tsx --test apps/daemon/src/*.test.ts apps/billing/src/*.test.ts apps/cloud/src/*.test.ts apps/portal/src/*.test.ts apps/cli/src/*.test.ts apps/tui/src/*.test.ts packages/*/src/*.test.ts",
    "service": "node --import tsx apps/daemon/src/index.ts",
    "install:dev-cli": "node scripts/install-dev-cli.mjs",
    "service:local": "node --import tsx scripts/service-local.ts",
    "cli": "node --import tsx apps/cli/src/index.ts",
    "mcp": "node --import tsx packages/mcp/src/index.ts",
    "preview": "vite preview apps/website --outDir ../../dist --host 127.0.0.1 --port 5173 --strictPort",
    "tui": "node --import tsx apps/tui/src/index.ts",
    "build:local": "node scripts/build-local.mjs",
    "schema": "node --import tsx scripts/schema.ts",
    "package:local": "node scripts/package-local.mjs",
    "build:installer": "node scripts/build-installer.mjs",
    "billing:serve": "node --import tsx apps/billing/src/index.ts",
    "billing:recover-lock": "node --import tsx scripts/recover-billing-lock.ts",
    "package:mac": "node scripts/package-mac.mjs",
    "release:keygen": "node scripts/release/provision-keygen.mjs",
    "release:team-license": "node scripts/release/issue-team-license.mjs",
    "test:distribution": "node --test scripts/distribution/*.test.mjs scripts/release/*.test.mjs",
    "proof:mac": "node scripts/proof-mac-package.mjs",
    "release:publish": "node scripts/release/publish-mac.mjs",
    "release:github": "node scripts/release/setup-github.mjs",
    "release:cask": "node --import tsx scripts/release/generate-cask.ts",
    "billing:build": "node apps/billing/build.mjs",
    "billing:operator": "node --import tsx apps/billing/src/operator.ts",
    "build:portal": "vite build apps/portal --base=/app/ --outDir ../../dist/app --emptyOutDir",
    "build:cloud": "node apps/cloud/build.mjs",
    "dev:portal": "vite apps/portal --host 127.0.0.1 --port 5175 --strictPort",
    "cloud:serve": "node --import tsx apps/cloud/src/index.ts",
    "test:portal": "node --import tsx --test apps/cloud/src/*.test.ts apps/portal/src/*.test.ts packages/machine-client/src/*.test.ts apps/daemon/src/hub-integration.test.ts apps/daemon/src/network.test.ts",
    "deploy:portal": "node scripts/deploy-portal.mjs",
    "qa:portal": "node --import tsx scripts/qa-portal.ts",
    "qa:portal-remote": "node scripts/qa-portal-remote.mjs",
    "qa:portal-pwa": "node scripts/qa-portal-pwa.mjs",
    "qa:phone-controls": "node scripts/qa-phone-controls.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.17.5",
    "firebase": "^12.19.0",
    "firebase-admin": "^14.4.0",
    "jose": "^6.2.12",
    "lucide-react": "^0.468.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "werift": "0.24.4",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/node": "^24.3.1",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "esbuild": "^0.25.9",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vite": "^7.1.5",
    "zod-to-json-schema": "^3.25.2"
  }
}
