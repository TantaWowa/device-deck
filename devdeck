#!/bin/zsh
# Repository-local CLI for the development profile used by service:local.
deck_root=${0:A:h}
cd "$deck_root" || exit 1
export DEVICE_DECK_HOME=${DEVICE_DECK_HOME:-$deck_root/work/local-deck}
if [[ "$1" == start ]]; then
  exec node --import tsx "$deck_root/scripts/start-local.ts"
fi
exec node "$deck_root/build/devdeck.mjs" "$@"
